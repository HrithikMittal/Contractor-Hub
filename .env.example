# Copy to .env.local for local overrides. With nothing set, the app runs in local mode
# (PGlite in .data/pglite, files in .data/uploads, sign-in code shown on screen).

# --- Database (Supabase → Connect → Transaction pooler, port 6543)
DATABASE_URL=

# --- Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=          # only for projects on the legacy JWT secret
# DOCUMENTS_BUCKET=eor-documents

# --- Supabase (browser, for Google sign-in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sign-in
AUTH_SECRET=                    # openssl rand -base64 48
RESEND_API_KEY=
MAIL_FROM="Contractor Hub <noreply@your-verified-domain.com>"
